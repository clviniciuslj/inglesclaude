<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Intencionalmente SEM android.permission.INTERNET: o app funciona 100% offline.
        O reconhecimento de voz online (quando usado) é feito pelo serviço do sistema, não pelo app.
        O CI falha se esta permissão aparecer no APK (scripts/verify-apk.sh).
    -->

    <application
        android:name=".EnglishLabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnglishLab">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EnglishLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
